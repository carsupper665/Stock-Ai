# USER 身分：這組 token 是管理所有虛擬帳號的唯一憑證
USER_TOKEN=change-me-to-a-long-random-string
USER_NAME=Bless

PORT=7794

# sqlite（開發／測試）或 postgres（正式）
DB_DRIVER=sqlite
DB_DSN=backend.db
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=stockai port=5432 sslmode=disable

LOG_DIR=logs
LOG_MAX_LINES=100000
DEBUG=false

# 手續費率：掛單成交 / 市價成交
FEE_RATE_MAKER=0.0002
FEE_RATE_TAKER=0.0004
