# Local development only. Release rejects ALLOW_STATIC_USER_TOKEN=true.
ALLOW_STATIC_USER_TOKEN=true
USER_TOKEN=change-me-to-a-long-random-string
USER_NAME=Bless

# OIDC access-token boundary. Test/Release use environment-specific HTTPS values.
# JWT signatures are accepted only with RS256 and typ must equal OIDC_TOKEN_TYPE.
# OIDC_ISSUER=https://idp.example/realms/stock-ai
# OIDC_AUDIENCE=stock-ai-api
# OIDC_USER_SUBJECT=stable-idp-subject
# OIDC_JWKS_URL=https://idp.example/realms/stock-ai/protocol/openid-connect/certs
OIDC_TOKEN_TYPE=at+jwt
# Optional for local development. Test/Release require ACCOUNT_TOKEN_KEY_FILE
# pointing at the environment namespace; generate it with production-secrets.ps1.
ACCOUNT_TOKEN_KEY=

PORT=7794

# sqlite（開發／測試）或 postgres（正式）
DB_DRIVER=sqlite
DB_DSN=backend.db
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=stockai port=5432 sslmode=disable

LOG_DIR=logs
LOG_MAX_LINES=100000
DEBUG=false

# 手續費率：掛單成交 / 市價成交
FEE_RATE_MAKER=0.0002
FEE_RATE_TAKER=0.0004

# 行情參數（規格 §8、§11 標示為「暫定」，可依實際狀況調整）
# 快取多久內算新鮮
MARKET_FRESH_TTL=1.5s
# 多久沒人要價就停掉訂閱
MARKET_IDLE_TIMEOUT=60s
# 等新報價的上限
MARKET_WAIT_TIMEOUT=5s

# 撮合引擎掃描掛單與停損停利的間隔
MATCHING_INTERVAL=1s
