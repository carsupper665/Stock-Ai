# External IdP settings for `bootstrap.py --idp-env FILE --oidc-client-secret-file FILE`.
# Copy outside Git and fill in. bootstrap.py writes the complete runtime compose.env
# (images, generated secrets, TLS directory, container group) from these values.

# Host[:port] that users open. The IdP client must register exactly:
#   Redirect URI:    https://<RELEASE_APP_HOST>/oauth2/callback
#   Post-logout URI: https://<RELEASE_APP_HOST>/
RELEASE_APP_HOST=stock-ai.corp.internal:8443
# Host address:port Nginx publishes. Keep 127.0.0.1 unless other machines must reach it.
RELEASE_BIND=127.0.0.1:8443
# Certificate (with intermediates) and key for RELEASE_APP_HOST.
RELEASE_TLS_CERT=/home/operator/stock-ai-tls/fullchain.pem
RELEASE_TLS_KEY=/home/operator/stock-ai-tls/privkey.pem

# Copy these from https://<issuer>/.well-known/openid-configuration; preflight compares them exactly.
OIDC_ISSUER=https://login.corp.internal/realms/stock-ai
OIDC_AUTHORIZATION_URL=https://login.corp.internal/realms/stock-ai/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://login.corp.internal/realms/stock-ai/protocol/openid-connect/token
OIDC_JWKS_URL=https://login.corp.internal/realms/stock-ai/protocol/openid-connect/certs
# Optional: leave empty when the IdP has no end-session endpoint.
OIDC_END_SESSION_URL=https://login.corp.internal/realms/stock-ai/protocol/openid-connect/logout

OIDC_CLIENT_ID=stock-ai
# client_secret_basic (default) or client_secret_post; must be in token_endpoint_auth_methods_supported.
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# The only account allowed to log in: the `sub` claim of its ID and access tokens.
OIDC_USER_SUBJECT=00000000-0000-0000-0000-000000000000
# Must appear in the access token `aud` claim (Keycloak needs an audience mapper on the client).
OIDC_AUDIENCE=stock-ai-api
# Exact `typ` header of the access token: at+jwt for RFC 9068 IdPs, JWT for Keycloak.
OIDC_TOKEN_TYPE=at+jwt

# Optional PEM with the IdP's intermediate/private CA and any explicitly trusted HTTPS-inspection roots (e.g. Kaspersky). Needed when the IdP
# sends only its leaf certificate or uses a private CA. Leave empty to trust public CAs only.
OIDC_CA_BUNDLE=
