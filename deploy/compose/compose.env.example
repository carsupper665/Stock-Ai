# Copy to an environment-local file outside Git and pass it with --env-file.
STOCK_AI_INSTANCE=stock-ai-test
STOCK_AI_ENVIRONMENT=Test
STOCK_AI_SECRET_NAMESPACE=stock-ai-test
STOCK_AI_SECRETS_DIR="/home/operator/Stock AI/local-test/secrets"
STOCK_AI_BACKUP_DIR="/home/operator/Stock AI/local-test/backups"

# Use the exact approved references. Ticket 10 replaces tags with promoted digests.
BACKEND_IMAGE=stock-ai/backend:0.7.0
AGENT_SERVER_IMAGE=stock-ai/agent-server:0.7.0
LLM_PROVIDER_SERVER_IMAGE=stock-ai/llm-provider-server:0.7.0
MIDDLEWARE_IMAGE=stock-ai/middleware:0.7.0
# Self-built Nginx image that also carries the frontend static files (docker/nginx.Dockerfile).
NGINX_IMAGE=stock-ai/nginx:0.7.0

# Credential-free startup model mapping. Keep Provider tokens in the mounted
# Provider database; never put credentials in this JSON value.
LLM_SERVER_MODEL_CATALOG=[]

# OIDC settings are read only by the Middleware (the sole login layer); compose.yaml
# requires all of them. The client secret and cookie key are secret files named
# <STOCK_AI_SECRET_NAMESPACE>_oidc_client_secret and _oidc_cookie_key in STOCK_AI_SECRETS_DIR.
OIDC_ISSUER=https://idp.test.example/realms/stock-ai-test
OIDC_AUTHORIZATION_URL=https://idp.test.example/realms/stock-ai-test/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://idp.test.example/realms/stock-ai-test/protocol/openid-connect/token
OIDC_JWKS_URL=https://idp.test.example/realms/stock-ai-test/protocol/openid-connect/certs
OIDC_END_SESSION_URL=https://idp.test.example/realms/stock-ai-test/protocol/openid-connect/logout
OIDC_CLIENT_ID=stock-ai-test
OIDC_REDIRECT_URI=https://app.test.example/oauth2/callback
OIDC_POST_LOGOUT_URI=https://app.test.example/
OIDC_COOKIE_NAME=__Host-stock-ai-test-session
OIDC_AUDIENCE=stock-ai-api-test
OIDC_USER_SUBJECT=replace-with-stable-test-subject
OIDC_TOKEN_TYPE=at+jwt
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
