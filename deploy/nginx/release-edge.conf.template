upstream stock_ai_middleware { server middleware:4180; keepalive 16; }

server {
    listen 8443 ssl default_server;
    server_name ${RELEASE_SERVER_NAME};
    set $release_host ${RELEASE_SERVER_NAME};
    absolute_redirect off;
    if ($host != $release_host) { return 421; }

    ssl_certificate /run/release-tls/fullchain.pem;
    ssl_certificate_key /run/release-tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;

    limit_conn connections_per_ip 30;

    location = /oauth2/start {
        limit_req zone=login_per_ip burst=5 nodelay;
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware;
        proxy_http_version 1.1;
        proxy_set_header Host ${RELEASE_APP_HOST};
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Accept $http_accept;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${RELEASE_APP_HOST};
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Original-URI "";
        proxy_set_header Authorization "";
    }

    location = /oauth2/callback {
        limit_req zone=login_per_ip burst=10 nodelay;
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware;
        proxy_http_version 1.1;
        proxy_set_header Host ${RELEASE_APP_HOST};
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Accept $http_accept;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${RELEASE_APP_HOST};
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Original-URI "";
        proxy_set_header Authorization "";
    }

    location ^~ /oauth2/ {
        limit_req zone=per_ip burst=30 nodelay;
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware;
        proxy_http_version 1.1;
        proxy_set_header Host ${RELEASE_APP_HOST};
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Accept $http_accept;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${RELEASE_APP_HOST};
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Server "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Original-URL "";
        proxy_set_header X-Original-URI "";
        proxy_set_header Authorization "";
    }

    # Deployment-specific routes, e.g. the local fixture IdP; empty for an external IdP.
    include /etc/nginx/release-extra/*.conf;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # The middleware's own health and version, shown in the frontend's service status panel.
    location = /middleware/healthz {
        limit_req zone=per_ip burst=40 nodelay;
        limit_except GET { deny all; }
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware/healthz;
        proxy_http_version 1.1;
    }

    location ^~ /assets/ {
        limit_req zone=per_ip burst=40 nodelay;
        limit_except GET HEAD { deny all; }
        root /usr/share/nginx/html;
    }

    location ~ ^/v1(?:/|$) {
        limit_req zone=per_ip burst=40 nodelay;
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware;
        proxy_http_version 1.1;
        proxy_set_header Host ${RELEASE_APP_HOST};
        proxy_set_header Accept $http_accept;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Content-Length $content_length;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${RELEASE_APP_HOST};
        proxy_set_header Authorization $http_authorization;
    }

    location ^~ /agent/ {
        limit_req zone=per_ip burst=40 nodelay;
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware;
        proxy_http_version 1.1;
        proxy_set_header Host ${RELEASE_APP_HOST};
        proxy_set_header Accept $http_accept;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Content-Length $content_length;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${RELEASE_APP_HOST};
        proxy_set_header Authorization $http_authorization;
    }

    location ^~ /llm/ {
        limit_req zone=per_ip burst=40 nodelay;
        proxy_pass_request_headers off;
        proxy_pass http://stock_ai_middleware;
        proxy_http_version 1.1;
        proxy_set_header Host ${RELEASE_APP_HOST};
        proxy_set_header Accept $http_accept;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Content-Length $content_length;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${RELEASE_APP_HOST};
        proxy_set_header Authorization $http_authorization;
    }

    location / {
        limit_req zone=per_ip burst=40 nodelay;
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
