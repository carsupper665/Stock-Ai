**
!.dockerignore
!docker
!docker/**
!oidc_gateway
!oidc_gateway/go.mod
!oidc_gateway/cmd
!oidc_gateway/cmd/**/*.go
!oidc_gateway/internal
!oidc_gateway/internal/**/*.go
oidc_gateway/internal/**/*_test.go
!scripts
!scripts/issuer-check
!scripts/issuer-check/**/*.go
!backend
!backend/go.mod
!backend/go.sum
!backend/*.go
!backend/cmd
!backend/cmd/**/*.go
!backend/internal
!backend/internal/**/*.go
!agent_server
!agent_server/go.mod
!agent_server/go.sum
!agent_server/cmd
!agent_server/cmd/**/*.go
!agent_server/internal
!agent_server/internal/**/*.go
!llm_provider_server
!llm_provider_server/go.mod
!llm_provider_server/go.sum
!llm_provider_server/cmd
!llm_provider_server/cmd/**/*.go
!llm_provider_server/internal
!llm_provider_server/internal/**/*.go
!frontend
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/vite.config.js
!frontend/src
!frontend/src/**
