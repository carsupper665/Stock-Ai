# 交易後端位址。空字串＝同源（開發走 vite proxy，正式走反向代理）
VITE_API_BASE=
# 登入方式：token（貼 USER Token）。接 IDP 後改 oidc
VITE_AUTH_PROVIDER=token
# 開發時預填登入框，只放 .env.local
VITE_DEV_TOKEN=

# 以下只給 vite dev proxy 用（沒有 VITE_ 前綴，不會進到瀏覽器）
# 三個服務的位址；代理把 /v1 → 交易後端、/agent/* → Agent Server、/llm/* → LLM Provider Server
BACKEND_URL=http://localhost:7794
AGENT_SERVER_URL=http://127.0.0.1:8080
LLM_SERVER_URL=http://127.0.0.1:8090
# 管理憑證由代理注入 Authorization，瀏覽器不持有；值要跟各服務的 .env 一致
AGENT_SERVER_ADMIN_TOKEN=
LLM_SERVER_ADMIN_TOKEN=
# /llm/v1/models（模型目錄）用的是 runtime 憑證
LLM_SERVER_RUNTIME_TOKEN=
